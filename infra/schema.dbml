// CS361 V2 — DBML for dbdiagram.io
// Paste this whole file into https://dbdiagram.io (or dbdocs.io) to render the ER diagram.
// Mirrors infra/schema.sql — keep both in sync when the schema changes.

Table companies {
  company_id    varchar(10) [pk, note: "required — e.g. C01"]
  name          text        [not null, note: "required — display + SEARCH"]
  short_name    text        [note: "optional — display + SEARCH (so 'KBTG' finds a Thai-only name)"]
  province      text        [not null, note: "required — FILTER"]
  location      text        [not null, note: "required — display, full address"]
  description   text        [default: '', note: "optional — reserved for V3, not populated"]
  logo_filename text        [note: "optional — display, falls back to short_name"]
  url           text        [note: "optional — display, card link"]
  created_at    timestamptz [default: `now()`, note: "optional — internal audit"]

  indexes {
    province [note: "btree — province filter, #28"]
    name [type: gin, note: "pg_trgm — name search, #27"]
    short_name [type: gin, note: "pg_trgm — short_name search, #27"]
  }
}

Table coop_info {
  info_id         integer [pk, increment]
  item_number     integer [not null]
  curriculum      varchar(10) [not null, note: "'61', '66', 'all'"]
  category        text    [not null, note: "qualification | required_course | gpa | behavior"]
  title           text    [not null]
  description     text    [not null]
  gpa_requirement decimal(3,2)
  academic_year   integer [not null, default: 2568]
  created_at      timestamptz [default: `now()`]
}

Table positions {
  position_id   varchar(10) [pk]
  company_id    varchar(10) [not null, ref: > companies.company_id]
  title         text        [not null]
  description   text        [default: '']
  position_type text
  created_at    timestamptz [default: `now()`]

  indexes {
    company_id
    position_type
  }

  note: "ON DELETE CASCADE from companies"
}

Table periods {
  period_id     varchar(10) [pk]
  name          text        [not null]
  academic_year integer     [not null]
  semester      varchar(5)  [not null, default: '1']
  is_active     boolean     [not null, default: false]
  created_at    timestamptz [default: `now()`]

  indexes {
    academic_year
    is_active
  }
}

Table coop_schedules {
  schedule_id   varchar(10) [pk]
  period_id     varchar(10) [not null, ref: > periods.period_id]
  title         text        [not null]
  description   text        [default: '']
  activity_type varchar(30) [not null]
  start_date    date        [not null]
  end_date      date        [not null]
  step_order    integer     [not null]
  created_at    timestamptz [default: `now()`]

  indexes {
    period_id
    step_order
    activity_type
  }
}

Table students {
  student_id VARCHAR(10) [pk]
  name       text        [not null]
  curriculum varchar(10)
  gpa        decimal(3,2)
  created_at timestamptz [default: `now()`]
}

Table coop_plans {
  plan_id     varchar(10) [pk]
  student_id  varchar(10) [not null, ref: > students.student_id]
  position_id varchar(10) [not null, ref: > positions.position_id]
  period_id   varchar(10) [not null, ref: > periods.period_id]
  status      varchar(20) [default: 'draft']
  created_at  timestamptz [default: `now()`]
  updated_at  timestamptz [default: `now()`]

  indexes {
    student_id
    position_id
    period_id
  }
}
