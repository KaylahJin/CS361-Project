// CS361 V3 — DBML for dbdiagram.io
// Paste this whole file into https://dbdiagram.io (or dbdocs.io) to render the ER diagram.
// Mirrors infra/schema.sql — keep both in sync when the schema changes.

Table companies {
  company_id    varchar(10) [pk, note: "required — e.g. C01"]
  name          text        [not null, note: "required — display + SEARCH"]
  short_name    text        [note: "optional — display + SEARCH (so 'KBTG' finds a Thai-only name)"]
  province      text        [not null, note: "required — FILTER"]
  location      text        [not null, note: "required — display, full address"]
  description   text        [default: '', note: "optional — reserved for V3, not populated"]
  logo_filename text        [note: "optional — display, falls back to short_name"]
  url           text        [note: "optional — display, card link"]
  created_at    timestamptz [default: `now()`, note: "optional — internal audit"]

  indexes {
    province [note: "btree — province filter, #28"]
    name [type: gin, note: "pg_trgm — name search, #27"]
    short_name [type: gin, note: "pg_trgm — short_name search, #27"]
  }
}

Table coop_info {
  info_id         integer [pk, increment]
  item_number     integer [not null]
  curriculum      varchar(10) [not null, note: "'61', '66', 'all'"]
  category        text    [not null, note: "qualification | required_course | gpa | behavior"]
  title           text    [not null]
  description     text    [not null]
  gpa_requirement decimal(3,2)
  academic_year   integer [not null, default: 2568]
  created_at      timestamptz [default: `now()`]
}

Table positions {
  position_id          varchar(10) [pk]
  company_id           varchar(10) [not null, ref: > companies.company_id, note: "ON DELETE RESTRICT"]
  title                varchar(255) [not null]
  category             varchar(50)  [not null]
  description          text
  qualification        text
  location             text
  work_mode            varchar(20)  [not null, default: 'unknown']
  application_deadline date
  application_url      text
  status               varchar(20)  [not null, default: 'unknown']
  source_url           text
  created_at           timestamptz  [default: `now()`]

  indexes {
    company_id
    category
    work_mode
    status
    title [type: gin, note: "pg_trgm — title search"]
  }

  note: "ON DELETE RESTRICT from companies"
}

Table periods {
  period_id     varchar(20) [pk]
  name          text        [not null]
  academic_year integer     [not null]
  semester      varchar(5)  [not null, default: '1']
  is_active     boolean     [not null, default: false]
  min_gpa       decimal(3,2)
  min_group_gpa decimal(3,2)
  capacity      integer
  created_at    timestamptz [default: `now()`]

  indexes {
    academic_year
    is_active
  }
}

Table coop_schedules {
  schedule_id   varchar(20) [pk]
  period_id     varchar(20) [not null, ref: > periods.period_id, note: "ON DELETE CASCADE"]
  title         text        [not null]
  description   text        [default: '']
  activity_type varchar(50) [not null, note: "APPLICATION | INTERVIEW | ORIENTATION | WORK_PERIOD | SUBMISSION"]
  start_date    date        [not null]
  end_date      date        [not null]
  step_order    integer     [not null]
  created_at    timestamptz [default: `now()`]

  indexes {
    period_id
    activity_type
  }
}

Table students {
  student_id varchar(10)  [pk]
  first_name text         [not null]
  last_name  text         [not null]
  email      text         [not null, unique]
  phone      varchar(20)
  birth_date date
  curriculum varchar(2)   [not null]
  gpa        decimal(3,2)

  indexes {
    curriculum
    first_name [type: gin, note: "pg_trgm — partial name search"]
    last_name  [type: gin, note: "pg_trgm — partial name search"]
  }
}

Table student_courses {
  student_id  varchar(10)  [not null, ref: > students.student_id]
  course_code varchar(10)  [not null]
  status      varchar(10)  [not null, note: "ENROLLED | PASSED | FAILED"]
  grade_point decimal(3,2)

  indexes {
    (student_id, course_code) [pk]
    (course_code, status)
  }
}

Table coop_plans {
  plan_id                 integer     [pk, increment]
  student_id              varchar(10) [not null, ref: > students.student_id]
  period_id               varchar(20) [ref: > periods.period_id]
  position_id             varchar(10) [ref: > positions.position_id]
  status                  varchar(20) [not null, default: 'PREPARING', note: "PREPARING | SUBMITTED | RETURNED | ENDORSED | ELIGIBLE | NOT_ELIGIBLE | SELECTED | NOT_SELECTED | APPROVED | REJECTED"]
  acknowledged_pre_course boolean     [not null, default: false]
  terms_accepted_at       timestamptz
  student_note            text
  submitted_at            timestamptz
  reviewer_name           varchar(100)
  reviewed_at             timestamptz
  review_comment          text
  created_at              timestamptz [not null, default: `now()`]
  updated_at              timestamptz [not null, default: `now()`]

  indexes {
    student_id
    (status, submitted_at)
    period_id
    position_id
    (student_id, period_id) [name: 'uq_coop_plans_active_period', note: "PARTIAL UNIQUE INDEX WHERE status IN ('PREPARING', 'SUBMITTED', 'RETURNED', 'ENDORSED', 'ELIGIBLE', 'SELECTED', 'NOT_SELECTED') — not full-table unique"]
  }
}

Table position_periods {
  position_id varchar(10) [not null, ref: > positions.position_id]
  period_id   varchar(20) [not null, ref: > periods.period_id]
  created_at  timestamptz [default: `now()`]

  indexes {
    (position_id, period_id) [pk]
    period_id
  }

  note: "Composite PK, ON DELETE CASCADE for both FKs"
}

Table app_users {
  cognito_sub varchar(64) [pk]
  email       text        [not null, unique]
  role        varchar(20) [not null, note: "STUDENT | ADVISOR | STAFF | COMMITTEE | ADMIN"]
  student_id  varchar(10) [ref: > students.student_id, note: "ON DELETE SET NULL; required when role = STUDENT"]
  is_active   boolean     [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    student_id
  }
}

Table advisor_student_assignments {
  advisor_sub varchar(64) [not null, ref: > app_users.cognito_sub, note: "ON DELETE CASCADE ON UPDATE CASCADE"]
  student_id  varchar(10) [not null, ref: > students.student_id, note: "ON DELETE CASCADE"]
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (advisor_sub, student_id) [pk]
    student_id
  }
}

Table plan_reviews {
  review_id    integer     [pk, increment]
  plan_id      integer     [not null, ref: > coop_plans.plan_id, note: "ON DELETE CASCADE"]
  reviewer_sub varchar(64) [not null, ref: > app_users.cognito_sub, note: "ON UPDATE CASCADE"]
  decision     varchar(20) [not null, note: "APPROVED | RETURNED | REJECTED | ENDORSED | NOT_ENDORSED | ELIGIBLE | INCOMPLETE | NOT_ELIGIBLE | SELECTED | NOT_SELECTED"]
  comment      text
  reviewed_at  timestamptz [not null, default: `now()`]
  step         varchar(20) [note: "ENDORSEMENT | SCREENING | SELECTION"]

  indexes {
    plan_id
  }
}

Table plan_attachments {
  attachment_id integer      [pk, increment]
  plan_id       integer      [not null, ref: > coop_plans.plan_id, note: "ON DELETE CASCADE"]
  s3_key        text         [not null, unique]
  file_name     text         [not null]
  content_type  varchar(100) [not null, default: 'application/pdf']
  size_bytes    integer      [not null]
  uploaded_by   varchar(64)  [not null, ref: > app_users.cognito_sub]
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    plan_id
  }
}
