# Copy to .env (gitignored), or just run `npm run env:sync` after a
# `terraform apply` and it will write this line for you.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to browser code, and it only
# reads this file at startup — restart `npm run dev` after any change here.

# Base URL of your API Gateway stage, no trailing slash. Get it with:
#   cd infra/terraform && terraform output -raw api_url
#
# This changes every time the API is destroyed and recreated. A stale value
# fails in the ugliest way possible: the old hostname stops resolving at all,
# so the browser shows a bare network error with no HTTP status to look up.
VITE_API_URL=https://replace-me.execute-api.us-east-1.amazonaws.com
